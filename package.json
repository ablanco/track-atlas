{
  "name": "track-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db:unit": "tsx --test tests/db/config.test.ts",
    "files:cleanup": "tsx --conditions=react-server scripts/cleanup-files.ts",
    "test:storage": "tsx --conditions=react-server --test tests/storage/*.test.ts",
    "test:tracks": "tsx --conditions=react-server --test tests/tracks/*.test.ts",
    "test:tracks:db": "tsx --conditions=react-server --test tests/db/tracks.test.ts tests/db/explore.test.ts tests/db/lists.test.ts",
    "test:storage:db": "tsx --conditions=react-server --test tests/db/files.test.ts tests/db/avatars.test.ts",
    "test:auth": "tsx --conditions=react-server --test tests/auth/*.test.ts",
    "test:db": "tsx --conditions=react-server --test tests/db/integration.test.ts tests/db/users.test.ts tests/db/sessions.test.ts tests/db/signup.test.ts tests/db/captcha.test.ts tests/db/login.test.ts tests/db/settings.test.ts tests/db/account-emails.test.ts tests/db/account-email-service.test.ts tests/db/email-clock.test.ts",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@base-ui/react": "^1.9.0",
    "@next/env": "16.4.2",
    "@phosphor-icons/react": "^2.1.10",
    "altcha": "3.3.0",
    "altcha-lib": "2.6.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "file-type": "^21.3.4",
    "geographiclib-geodesic": "^2.2.0",
    "maplibre-gl": "5.24.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "8.1.3",
    "recharts": "3.8.0",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.0",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "24.10.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.28.5"
}
