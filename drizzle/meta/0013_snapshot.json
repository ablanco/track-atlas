        },
        "tracks_activity_check": {
          "name": "tracks_activity_check",
          "value": "\"tracks\".\"activity\" IN ('walking', 'hiking', 'road_running', 'trail_running', 'cycling', 'mountain_biking', 'ski_touring', 'cross_country_skiing', 'snowshoeing', 'paddling', 'horse_riding', 'four_by_four', 'road_motorcycling', 'off_road_motorcycling', 'atv_quad', 'other')"
        },
        "tracks_classification_check": {
          "name": "tracks_classification_check",
          "value": "\"tracks\".\"difficulty\" BETWEEN 1 AND 5 AND \"tracks\".\"visibility\" IN ('private', 'public') AND \"tracks\".\"version\" = 1"
        },
        "tracks_elevation_coverage_check": {
          "name": "tracks_elevation_coverage_check",
          "value": "((\"tracks\".\"elevation_sample_count\" = 0) = (\"tracks\".\"min_elevation_meters\" IS NULL AND \"tracks\".\"max_elevation_meters\" IS NULL)) AND (\"tracks\".\"elevation_sample_count\" = 0 OR (\"tracks\".\"min_elevation_meters\" IS NOT NULL AND \"tracks\".\"max_elevation_meters\" IS NOT NULL AND \"tracks\".\"min_elevation_meters\" <= \"tracks\".\"max_elevation_meters\")) AND ((\"tracks\".\"elevation_sample_count\" = \"tracks\".\"point_count\") = (\"tracks\".\"ascent_meters\" IS NOT NULL AND \"tracks\".\"descent_meters\" IS NOT NULL)) AND ((\"tracks\".\"ascent_meters\" IS NULL) = (\"tracks\".\"descent_meters\" IS NULL))"
        },
        "tracks_metrics_check": {
          "name": "tracks_metrics_check",
          "value": "\"tracks\".\"point_count\" BETWEEN 2 AND 100000 AND \"tracks\".\"distance_meters\" > 0 AND \"tracks\".\"distance_meters\" < 'Infinity'::float8 AND \"tracks\".\"elevation_sample_count\" BETWEEN 0 AND \"tracks\".\"point_count\" AND (\"tracks\".\"duration_seconds\" IS NULL OR (\"tracks\".\"duration_seconds\" > 0 AND \"tracks\".\"duration_seconds\" < 'Infinity'::float8)) AND (\"tracks\".\"ascent_meters\" IS NULL OR (\"tracks\".\"ascent_meters\" >= 0 AND \"tracks\".\"ascent_meters\" < 'Infinity'::float8)) AND (\"tracks\".\"descent_meters\" IS NULL OR (\"tracks\".\"descent_meters\" >= 0 AND \"tracks\".\"descent_meters\" < 'Infinity'::float8)) AND (\"tracks\".\"min_elevation_meters\" IS NULL OR (\"tracks\".\"min_elevation_meters\" > '-Infinity'::float8 AND \"tracks\".\"min_elevation_meters\" < 'Infinity'::float8)) AND (\"tracks\".\"max_elevation_meters\" IS NULL OR (\"tracks\".\"max_elevation_meters\" > '-Infinity'::float8 AND \"tracks\".\"max_elevation_meters\" < 'Infinity'::float8))"
        }
      },
