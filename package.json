{
  "name": "track-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:db:unit": "tsx --test tests/db/config.test.ts",
    "test:auth": "tsx --conditions=react-server --test tests/auth/*.test.ts",
    "test:db": "tsx --conditions=react-server --test tests/db/integration.test.ts tests/db/users.test.ts tests/db/sessions.test.ts tests/db/signup.test.ts tests/db/captcha.test.ts tests/db/login.test.ts tests/db/settings.test.ts",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint"
  },
  "dependencies": {
    "@next/env": "16.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "altcha": "3.3.0",
    "altcha-lib": "2.6.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.28.5"
}
