        "stored_files_avatar_versions_check": {
          "name": "stored_files_avatar_versions_check",
          "value": "(\n    \"stored_files\".\"avatar_128_bytes\" IS NULL AND \"stored_files\".\"avatar_128_sha256\" IS NULL AND \"stored_files\".\"avatar_24_bytes\" IS NULL AND \"stored_files\".\"avatar_24_sha256\" IS NULL\n  ) OR (\n    \"stored_files\".\"purpose\" = 'avatar' AND\n    \"stored_files\".\"avatar_128_bytes\" IS NOT NULL AND \"stored_files\".\"avatar_128_bytes\" BETWEEN 1 AND 65536 AND\n    \"stored_files\".\"avatar_24_bytes\" IS NOT NULL AND \"stored_files\".\"avatar_24_bytes\" BETWEEN 1 AND 65536 AND\n    \"stored_files\".\"avatar_128_sha256\" IS NOT NULL AND \"stored_files\".\"avatar_128_sha256\" ~ '^[a-f0-9]{64}$' AND\n    \"stored_files\".\"avatar_24_sha256\" IS NOT NULL AND \"stored_files\".\"avatar_24_sha256\" ~ '^[a-f0-9]{64}$'\n  )"
        },
        "stored_files_purpose_check": {
          "name": "stored_files_purpose_check",
          "value": "\"stored_files\".\"purpose\" IN ('avatar', 'gpx')"
        },
        "stored_files_status_check": {
          "name": "stored_files_status_check",
          "value": "\"stored_files\".\"status\" IN ('pending', 'ready', 'deleting')"
        },
        "stored_files_size_check": {
          "name": "stored_files_size_check",
          "value": "\"stored_files\".\"byte_size\" > 0 AND \"stored_files\".\"byte_size\" <= 10485760"
        },
        "stored_files_object_key_check": {
          "name": "stored_files_object_key_check",
          "value": "\"stored_files\".\"object_key\" = \"stored_files\".\"id\"::text OR (\"stored_files\".\"purpose\" = 'avatar' AND \"stored_files\".\"object_key\" = 'avatars/original/' || \"stored_files\".\"id\"::text)"
        },
        "stored_files_location_check": {
          "name": "stored_files_location_check",
          "value": "\"stored_files\".\"storage_location\" ~ '^[a-f0-9]{64}$'"
        },
        "stored_files_ready_check": {
          "name": "stored_files_ready_check",
          "value": "\"stored_files\".\"status\" <> 'ready' OR (\"stored_files\".\"content_type\" IS NOT NULL AND \"stored_files\".\"sha256\" IS NOT NULL AND \"stored_files\".\"sha256\" ~ '^[a-f0-9]{64}$' AND ((\"stored_files\".\"purpose\" = 'avatar' AND \"stored_files\".\"content_type\" ~ '^image/[a-z0-9][a-z0-9.+-]*$' AND \"stored_files\".\"content_type\" <> 'image/svg+xml') OR (\"stored_files\".\"purpose\" = 'gpx' AND \"stored_files\".\"content_type\" = 'application/gpx+xml')))"
        },
