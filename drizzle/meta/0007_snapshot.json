        "stored_files_purpose_check": {
          "name": "stored_files_purpose_check",
          "value": "\"stored_files\".\"purpose\" IN ('avatar', 'gpx')"
        },
        "stored_files_status_check": {
          "name": "stored_files_status_check",
          "value": "\"stored_files\".\"status\" IN ('pending', 'ready', 'deleting')"
        },
        "stored_files_size_check": {
          "name": "stored_files_size_check",
          "value": "\"stored_files\".\"byte_size\" > 0 AND \"stored_files\".\"byte_size\" <= 10485760"
        },
        "stored_files_object_key_check": {
          "name": "stored_files_object_key_check",
          "value": "\"stored_files\".\"object_key\" = \"stored_files\".\"id\"::text OR (\"stored_files\".\"purpose\" = 'avatar' AND \"stored_files\".\"object_key\" = 'avatars/original/' || \"stored_files\".\"id\"::text)"
        },
        "stored_files_location_check": {
          "name": "stored_files_location_check",
          "value": "\"stored_files\".\"storage_location\" ~ '^[a-f0-9]{64}$'"
        },
        "stored_files_ready_check": {
          "name": "stored_files_ready_check",
          "value": "\"stored_files\".\"status\" <> 'ready' OR (\"stored_files\".\"content_type\" IS NOT NULL AND \"stored_files\".\"sha256\" IS NOT NULL AND \"stored_files\".\"sha256\" ~ '^[a-f0-9]{64}$' AND ((\"stored_files\".\"purpose\" = 'avatar' AND \"stored_files\".\"content_type\" IN ('image/jpeg', 'image/png', 'image/webp')) OR (\"stored_files\".\"purpose\" = 'gpx' AND \"stored_files\".\"content_type\" = 'application/gpx+xml')))"
        },
        "stored_files_deleting_check": {
          "name": "stored_files_deleting_check",
          "value": "(\"stored_files\".\"status\" = 'deleting') = (\"stored_files\".\"delete_after\" IS NOT NULL)"
        }
      },
