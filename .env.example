# Local development only. Do not use these credentials in production.
POSTGRES_DB=track_atlas
POSTGRES_USER=track_atlas
POSTGRES_PASSWORD=track_atlas
POSTGRES_PORT=5432

# Next.js runs on the host; keep this aligned with the settings above.
DATABASE_URL=postgresql://track_atlas:track_atlas@localhost:5432/track_atlas

# Required for signup CAPTCHA. Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this stable and identical across application instances; never use NEXT_PUBLIC_.
ALTCHA_HMAC_SECRET=

# Email: capture writes private local JSON under .superpowers/mail (never in production).
# Set to brevo for real sending; authenticate the sender/domain and disable tracking in Brevo.
EMAIL_DELIVERY_MODE=capture
APP_ORIGIN=http://localhost:3000
# Generate at least 32 random bytes and keep stable across instances, like ALTCHA_HMAC_SECRET.
EMAIL_RATE_LIMIT_SECRET=
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Track Atlas

# Optional public Mapbox token for the Satellite basemap; restrict by site origin.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Private uploaded files. Production requires an explicit local or b2 backend.
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_DIR=.data/uploads
# For b2, use a private bucket and a bucket-restricted application key.
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
